
{
  "expo": {
    "name": "VedaMilan AI",
    "slug": "vedamilan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vedamilan",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.vedamilan.app",
      "associatedDomains": [
        "applinks:vedamilan-lihn.vercel.app"
      ],
      "infoPlist": {
        "NSCameraUsageDescription": "VedaMilan uses your camera to add profile photos and share images in chats.",
        "NSPhotoLibraryUsageDescription": "VedaMilan lets you choose profile photos and chat images from your library.",
        "NSMicrophoneUsageDescription": "VedaMilan uses the microphone for voice messages and voice guidance.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.vedamilan.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071120"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vedamilan-lihn.vercel.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071120",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "dark": {
            "backgroundColor": "#071120"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C89B3C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VedaMilan lets you choose profile photos from your library.",
          "cameraPermission": "VedaMilan uses your camera to add profile photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "owner": "vedamilan"
  }
}
