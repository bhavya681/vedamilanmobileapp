# ---------------------------------------------------------------------------
# VedaMilan Mobile — environment
# Only EXPO_PUBLIC_* values are embedded in the client bundle.
# Never put API secrets, Stripe/Razorpay secrets, Cloudinary secrets or
# database credentials in this file.
# ---------------------------------------------------------------------------

# Existing Next.js backend (no trailing slash)
EXPO_PUBLIC_API_URL=https://vedamilan-lihn.vercel.app

# Realtime (public Pusher key only — same values as the web app)
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=ap2

# Optional: enable the "Open web sign-in" affordance for Google
EXPO_PUBLIC_WEB_URL=https://vedamilan-lihn.vercel.app

# Analytics disabled unless a DSN is intentionally configured
EXPO_PUBLIC_ANALYTICS_ENABLED=false
